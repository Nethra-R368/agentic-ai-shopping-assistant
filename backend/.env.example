# Copy to backend/.env and fill in what you have. Every key is optional:
#   nothing set           -> demo mode (sample catalog, rule-based insights, in-memory DB)
#   + GEMINI_API_KEY      -> AI summaries, pros/cons, comparisons, image search, agent follow-ups
#   + SERPAPI_API_KEY     -> live Google Shopping prices, images and store links
#   + MONGO_URI           -> accounts, wishlists, alerts and chats survive restarts

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
SERPAPI_API_KEY=
MONGO_URI=
MONGO_DB_NAME=aurabuy

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me-in-production

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEARCH_COUNTRY=in
